# Copy to .env locally and replace every placeholder with a unique random value.
# Never commit .env or reuse these placeholder values.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
AUTH_BACKEND_KEY=REPLACE_WITH_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
# Optional Telegram delivery. Keep the real bot token only in the local .env.
TELEGRAM_BOT_TOKEN=
ANET_PANEL_PUBLIC_URL=https://panel.example.org
ANET_CLIENT_DOWNLOAD_URL=https://github.com/igor04091968/anet-android/releases/latest/download/ANet-Android9-10.apk
# Optional proxy reachable from anet-auth, e.g. http://host.docker.internal:18089
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres
