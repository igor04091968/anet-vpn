DATABASE_URL=postgres://user:password@localhost:5432/anet_auth_db
AUTH_BACKEND_KEY=super_secret_vpn_key_2025
BIND_TO=127.0.0.1:3000
DB_ENCRYPTION_KEY=test_test
CLIENT_TEMPLATE_PATH=/opt/anet/client_template.toml
# Optional: enables subscriber delivery from the management panel.
TELEGRAM_BOT_TOKEN=
ANET_PANEL_PUBLIC_URL=https://panel.example.org
ANET_CLIENT_DOWNLOAD_URL=https://github.com/owner/anet/releases/latest
# Optional outbound HTTP proxy for the Telegram Bot API, for example a local HTTP CONNECT relay.
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres
